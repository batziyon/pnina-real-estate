# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pnina_real_estate"

# Authentication (Auth.js v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Bootstrap Admin (for prisma seed)
# These are used to create/update the initial admin user
# Change the password immediately after first login
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="your-secure-password-here"

# AI Provider (Google Gemini)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Object Storage (Vercel Blob)
# Get your token from: https://vercel.com/dashboard/stores
# Required for media uploads (property images)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"
