// =============================================================================
// Prisma Schema — Pnina Real Estate
// ORM:      Prisma 7 (@prisma/client 7.10.0)
// Database: PostgreSQL (Neon)
//
// Geographic model: Jerusalem-only brokerage.
// City is NOT a free-text field. Neighborhood is the first-class geographic
// entity. All property/project/valuation records link to a Neighborhood.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  AGENT
  EDITOR
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum DealType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  PENTHOUSE
  HOUSE
  VILLA
  DUPLEX
  STUDIO
  OFFICE
  COMMERCIAL
  LAND
  OTHER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum InquiryType {
  PROPERTY_INTEREST
  VALUATION_REQUEST
  COOPERATION
  GENERAL_CONTACT
}

enum ValuationRequestStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

// =============================================================================
// NEIGHBORHOOD
// Geographic lookup table. This brokerage operates only in Jerusalem.
// =============================================================================

model Neighborhood {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  properties        Property[]
  projects          Project[]
  valuationRequests ValuationRequest[]

  @@index([active, sortOrder])
  @@map("neighborhoods")
}

// =============================================================================
// USER
// =============================================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  properties Property[]
  inquiries  Inquiry[]  @relation("AssignedAgent")

  @@index([email])
  @@index([role])
  @@map("users")
}

// =============================================================================
// PROJECT
// =============================================================================

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  neighborhoodId String
  address        String?
  status         ProjectStatus @default(DRAFT)
  coverImage     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])
  properties   Property[]

  @@index([status])
  @@index([neighborhoodId])
  @@map("projects")
}

// =============================================================================
// PROPERTY
// =============================================================================

model Property {
  id             String         @id @default(cuid())
  title          String
  description    String?
  dealType       DealType
  propertyType   PropertyType
  price          Decimal        @db.Decimal(14, 2)
  neighborhoodId String
  address        String?
  rooms          Decimal?       @db.Decimal(4, 1)
  area           Decimal?       @db.Decimal(10, 2)
  floor          Int?
  totalFloors    Int?
  status         PropertyStatus @default(DRAFT)

  // Features stored as individual boolean columns for direct filtering
  parking         Boolean @default(false)
  elevator        Boolean @default(false)
  balcony         Boolean @default(false)
  safeRoom        Boolean @default(false)
  storage         Boolean @default(false)
  airConditioning Boolean @default(false)
  accessible      Boolean @default(false)
  furnished       Boolean @default(false)

  // Foreign keys
  agentId   String
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  neighborhood Neighborhood    @relation(fields: [neighborhoodId], references: [id])
  agent        User            @relation(fields: [agentId], references: [id])
  project      Project?        @relation(fields: [projectId], references: [id])
  images       PropertyImage[]
  videos       PropertyVideo[]
  inquiries    Inquiry[]

  @@index([status])
  @@index([dealType])
  @@index([propertyType])
  @@index([neighborhoodId])
  @@index([agentId])
  @@index([projectId])
  @@index([status, dealType])
  @@index([status, neighborhoodId])
  @@map("properties")
}

// =============================================================================
// PROPERTY IMAGE
// =============================================================================

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_images")
}

// =============================================================================
// PROPERTY VIDEO
// =============================================================================

model PropertyVideo {
  id           String   @id @default(cuid())
  propertyId   String
  url          String
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_videos")
}

// =============================================================================
// INQUIRY
// =============================================================================

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  agentId    String?
  name       String
  phone      String
  email      String?
  message    String?
  type       InquiryType   @default(GENERAL_CONTACT)
  status     InquiryStatus @default(NEW)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  property Property @relation(fields: [propertyId], references: [id])
  agent    User?    @relation("AssignedAgent", fields: [agentId], references: [id])

  @@index([propertyId])
  @@index([agentId])
  @@index([status])
  @@index([type])
  @@index([status, agentId])
  @@map("inquiries")
}

// =============================================================================
// VALUATION REQUEST
// =============================================================================

model ValuationRequest {
  id             String                 @id @default(cuid())
  name           String
  phone          String
  email          String?
  neighborhoodId String
  address        String?
  propertyType   PropertyType?
  rooms          Decimal?               @db.Decimal(4, 1)
  area           Decimal?               @db.Decimal(10, 2)
  message        String?
  status         ValuationRequestStatus @default(NEW)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // Relations
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])

  @@index([neighborhoodId])
  @@index([status])
  @@index([createdAt])
  @@map("valuation_requests")
}

// =============================================================================
// TESTIMONIAL
// =============================================================================

model Testimonial {
  id          String            @id @default(cuid())
  name        String
  displayName String?
  content     String
  status      TestimonialStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@map("testimonials")
}
