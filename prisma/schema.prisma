// =============================================================================
// Prisma Schema — Pnina Real Estate
// ORM:      Prisma 7 (@prisma/client 7.10.0)
// Database: PostgreSQL (Neon)
//
// Geographic model: Jerusalem-only brokerage.
// City is NOT a free-text field. Neighborhood is the first-class geographic
// entity. All property/project/valuation records link to a Neighborhood.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  ADMIN
  AGENT
  EDITOR
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  UNDER_CONTRACT
  SOLD
  RENTED
  ARCHIVED
}

enum DealType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  PENTHOUSE
  HOUSE
  VILLA
  DUPLEX
  STUDIO
  OFFICE
  COMMERCIAL
  LAND
  OTHER
}

enum RepresentationType {
  EXCLUSIVE
  NON_EXCLUSIVE
  COOPERATION
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum InquiryType {
  PROPERTY_INTEREST
  VALUATION_REQUEST
  COOPERATION
  GENERAL_CONTACT
}

enum ValuationRequestStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactRoleType {
  BUYER
  SELLER
  RENTER
  LANDLORD
  INVESTOR
  COLLABORATOR
  OTHER
}

enum RequirementPreferenceType {
  REQUIRED
  PREFERRED
}

enum PropertyStatusChangeReason {
  DEAL_FELL_THROUGH
  TRANSACTION_COMPLETED
  RENTAL_ENDED
  OWNER_DECISION
  PRICE_CHANGE
  OTHER
}

// =============================================================================
// NEIGHBORHOOD
// Geographic lookup table. This brokerage operates only in Jerusalem.
// =============================================================================

model Neighborhood {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  properties                    Property[]
  projects                      Project[]
  valuationRequests             ValuationRequest[]
  buyerRequirementNeighborhoods BuyerRequirementNeighborhood[]

  @@index([active, sortOrder])
  @@map("neighborhoods")
}

// =============================================================================
// USER
// =============================================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  role         UserRole @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  properties       Property[]
  inquiries        Inquiry[]  @relation("AssignedAgent")
  assignedContacts Contact[]  @relation("AssignedContactAgent")
  statusChanges    PropertyStatusHistory[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// =============================================================================
// CONTACT
// Central CRM person/entity.
// =============================================================================

model Contact {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  email           String?
  notes           String?
  assignedAgentId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  assignedAgent     User?              @relation("AssignedContactAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  roles             ContactRole[]
  buyerRequirements BuyerRequirement[]
  ownedProperties   Property[]         @relation("PropertyOwner")
  inquiries         Inquiry[]
  testimonials      Testimonial[]

  @@index([phone])
  @@index([email])
  @@index([assignedAgentId])
  @@index([createdAt])
  @@map("contacts")
}

// =============================================================================
// CONTACT ROLE
// A contact may have multiple roles.
// =============================================================================

model ContactRole {
  id        String          @id @default(cuid())
  contactId String
  role      ContactRoleType
  notes     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  // Relations
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, role])
  @@index([contactId])
  @@index([role])
  @@index([active])
  @@map("contact_roles")
}

// =============================================================================
// BUYER REQUIREMENT
// Structured search requirements belonging to a Contact.
// =============================================================================

model BuyerRequirement {
  id           String        @id @default(cuid())
  contactId    String
  dealType     DealType
  propertyType PropertyType?
  minRooms     Decimal?      @db.Decimal(4, 1)
  maxRooms     Decimal?      @db.Decimal(4, 1)
  minArea      Decimal?      @db.Decimal(10, 2)
  maxArea      Decimal?      @db.Decimal(10, 2)
  minPrice     Decimal?      @db.Decimal(14, 2)
  maxPrice     Decimal?      @db.Decimal(14, 2)
  notes        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  contact                Contact                        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  preferredNeighborhoods BuyerRequirementNeighborhood[]

  @@index([contactId])
  @@index([dealType])
  @@index([propertyType])
  @@index([active])
  @@index([createdAt])
  @@map("buyer_requirements")
}

// =============================================================================
// BUYER REQUIREMENT ↔ NEIGHBORHOOD
// Many-to-many relation with explicit preference level.
// =============================================================================

model BuyerRequirementNeighborhood {
  id                 String                    @id @default(cuid())
  buyerRequirementId String
  neighborhoodId     String
  preferenceType     RequirementPreferenceType @default(PREFERRED)

  // Relations
  buyerRequirement BuyerRequirement @relation(fields: [buyerRequirementId], references: [id], onDelete: Cascade)
  neighborhood     Neighborhood     @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@unique([buyerRequirementId, neighborhoodId])
  @@index([buyerRequirementId])
  @@index([neighborhoodId])
  @@index([preferenceType])
  @@map("buyer_requirement_neighborhoods")
}

// =============================================================================
// PROJECT
// =============================================================================

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  neighborhoodId String
  address        String?
  status         ProjectStatus @default(DRAFT)
  coverImage     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])
  properties   Property[]

  @@index([status])
  @@index([neighborhoodId])
  @@map("projects")
}

// =============================================================================
// PROPERTY
// =============================================================================

model Property {
  id             String       @id @default(cuid())
  title          String
  description    String?
  dealType       DealType
  propertyType   PropertyType
  price          Decimal      @db.Decimal(14, 2)
  neighborhoodId String

  // Address
  // `address` is retained temporarily for backwards compatibility.
  address     String?
  street      String?
  houseNumber String?

  rooms       Decimal?       @db.Decimal(4, 1)
  area        Decimal?       @db.Decimal(10, 2)
  floor       Int?
  totalFloors Int?
  status      PropertyStatus @default(DRAFT)

  // Internal business information
  internalNotes      String?
  representationType RepresentationType @default(NON_EXCLUSIVE)

  // Features stored as individual boolean columns for direct filtering
  parking         Boolean @default(false)
  elevator        Boolean @default(false)
  balcony         Boolean @default(false)
  safeRoom        Boolean @default(false)
  storage         Boolean @default(false)
  airConditioning Boolean @default(false)
  accessible      Boolean @default(false)
  furnished       Boolean @default(false)

  // Foreign keys
  agentId        String
  projectId      String?
  ownerContactId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  neighborhood Neighborhood    @relation(fields: [neighborhoodId], references: [id])
  agent        User            @relation(fields: [agentId], references: [id])
  project      Project?        @relation(fields: [projectId], references: [id])
  ownerContact Contact?        @relation("PropertyOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  images       PropertyImage[]
  videos       PropertyVideo[]
  inquiries    Inquiry[]
  statusHistory PropertyStatusHistory[]

  @@index([status])
  @@index([dealType])
  @@index([propertyType])
  @@index([neighborhoodId])
  @@index([agentId])
  @@index([projectId])
  @@index([ownerContactId])
  @@index([representationType])
  @@index([status, dealType])
  @@index([status, neighborhoodId])
  @@map("properties")
}

// =============================================================================
// PROPERTY IMAGE
// =============================================================================

model PropertyImage {
  id         String   @id  // Client-provided from upload intent (no auto-generation)
  propertyId String
  storageKey String?  @unique  // Storage location (source of truth for new uploads)
  url        String   // Public CDN URL
  alt        String?
  sortOrder  Int      @default(0)
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_images")
}

// =============================================================================
// PROPERTY VIDEO
// =============================================================================

model PropertyVideo {
  id           String   @id
  propertyId   String
  storageKey   String?  @unique
  url          String
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
  @@map("property_videos")
}

// =============================================================================
// INQUIRY
// =============================================================================

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String?
  contactId  String?
  agentId    String?
  name       String
  phone      String
  email      String?
  message    String?
  type       InquiryType   @default(GENERAL_CONTACT)
  status     InquiryStatus @default(NEW)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  property Property? @relation(fields: [propertyId], references: [id])
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  agent    User?     @relation("AssignedAgent", fields: [agentId], references: [id])

  @@index([propertyId])
  @@index([contactId])
  @@index([agentId])
  @@index([status])
  @@index([type])
  @@index([status, agentId])
  @@map("inquiries")
}

// =============================================================================
// VALUATION REQUEST
// =============================================================================

model ValuationRequest {
  id             String                 @id @default(cuid())
  name           String
  phone          String
  email          String?
  neighborhoodId String
  address        String?
  propertyType   PropertyType?
  rooms          Decimal?               @db.Decimal(4, 1)
  area           Decimal?               @db.Decimal(10, 2)
  message        String?
  status         ValuationRequestStatus @default(NEW)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  // Relations
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])

  @@index([neighborhoodId])
  @@index([status])
  @@index([createdAt])
  @@map("valuation_requests")
}

// =============================================================================
// TESTIMONIAL
// =============================================================================

model Testimonial {
  id          String            @id @default(cuid())
  contactId   String?
  name        String
  displayName String?
  content     String
  status      TestimonialStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([contactId])
  @@index([status])
  @@map("testimonials")
}

// =============================================================================
// PROPERTY STATUS HISTORY
// Tracks all status transitions for properties with business reasons.
// =============================================================================

model PropertyStatusHistory {
  id         String                     @id @default(cuid())
  propertyId String
  fromStatus PropertyStatus?
  toStatus   PropertyStatus
  reason     PropertyStatusChangeReason
  notes      String?
  changedBy  String
  createdAt  DateTime                   @default(now())

  // Relations
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  changedByUser User @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([propertyId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("property_status_history")
}
